#! /bin/sh

#start fade
#~/.config/bspwm/fade-in.sh &

pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor -d 1 2 3 4 5 6 7 8 9 

bspc config border_width         1
bspc config window_gap           10

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

# Startup windows — don't let bspwm tile/manage them
#bspc rule -a 'xmessage.Xmessage' manage=off
#bspc rule -a mechvibes --hidden manage=off


#autostart
sxhkd &
picom --config $HOME/.config/picom/picom.conf &
dunst &
#ulauncher &
#bash $HOME/.config/polybar/launch.sh --cuts &
bash $HOME/.config/polybar/launch.sh &
#wallset --video ~/Videos/video.mp4 &
#feh --bg-scale "" ~/Pictures/jpg &
feh --bg-fill ~/Pictures/wallpapers/a_body_of_water_with_buildings_in_the_background.jpg  ~/Pictures/wallpapers/a_body_of_water_with_buildings_in_the_background.jpg  &
xrandr --output HDMI-A-0 --rotate left --right-of eDP &
#xwinwrap -g 1920x1200+0+0 -ov -ni -- mpv -wid WID --loop --no-audio ~/Videos/pm.mp4 &
#xwinwrap -g 1080x1920+1920+0 -ov -ni -- mpv -wid WID --loop --no-audio ~/Videos/sm.mp4 &
# Launch Mechvibes and immediately hide it to the system tray
#mechvibes &
# RustyVibes keyboard sounds
pkill -x rustyvibes 2>/dev/null
"$HOME/.cargo/bin/rustyvibes" \
    "$HOME/Music/RustyVibes/cherry-blue-pbt-rustyvibes" \
    >/tmp/rustyvibes.log 2>&1 &


